{
  "name": "vringon-pathtracer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VRINGON path-traced 3D web viewer (three.js + three-gpu-pathtracer)",
  "scripts": {
    "dev": "vite --port 5230 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5231 --strictPort",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "three": "0.172.0",
    "three-mesh-bvh": "0.9.7",
    "three-gpu-pathtracer": "0.0.23",
    "oidn-web": "0.3.5"
  },
  "devDependencies": {
    "@types/three": "0.172.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.5"
  }
}
